# 本文件只列键名;真实密钥只进 Vercel 环境变量,绝不提交仓库
# 全部留空时走确定性 Mock(无密钥可跑)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# 国产模型(OpenAI 兼容端点)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# proposal 完整性签名密钥(不配则用开发缺省值)
PROPOSAL_SECRET=
# 场景分模型(可选):原则生成用强模型,不配则回落上面的默认模型
OPENAI_COMPAT_MODEL_STRONG=
ANTHROPIC_MODEL_STRONG=
# 每个服务实例每天最多发起的真实模型调用次数；0 表示始终走确定性 Mock
MODEL_DAILY_BUDGET=2000
